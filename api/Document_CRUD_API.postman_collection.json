{
  "info": {
    "name": "Document CRUD API (Assignment)",
    "description": "Full CRUD for document retrieval platform. Base URL: https://wastejustice.online/actions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://wastejustice.online/actions" },
    { "key": "documentId", "value": "document_001" }
  ],
  "item": [
    {
      "name": "1. Read All",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/read_all.php",
        "description": "GET all documents. Response: {\"success\": true, \"data\": [...]}. Each item includes \"id\"."
      }
    },
    {
      "name": "2. Read One",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/read_one.php?id={{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["read_one.php"],
          "query": [{ "key": "id", "value": "{{documentId}}", "description": "Document ID (e.g. document_001)" }]
        },
        "description": "GET one document by id. Response: {\"success\": true, \"data\": {...}} or {\"success\": false, \"error\": \"not found\"}"
      }
    },
    {
      "name": "3. Create",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "description", "value": "Postman test document", "description": "Required" },
            { "key": "location", "value": "Kinshasa", "description": "Required" },
            { "key": "userID", "value": "1", "description": "Required - existing User ID" },
            { "key": "schoolID", "value": "2", "description": "Required - existing User ID (issuer)" },
            { "key": "documentTypeID", "value": "1", "description": "Required - 1 to 5" }
          ]
        },
        "url": "{{baseUrl}}/create.php",
        "description": "POST new document. Response: {\"success\": true, \"data\": {\"id\": \"doc_xxxxx\"}}. Copy returned id for Update/Delete."
      }
    },
    {
      "name": "4. Update",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "id", "value": "{{documentId}}", "description": "Required - document ID to update" },
            { "key": "description", "value": "Updated for PDF report" },
            { "key": "location", "value": "Updated City" },
            { "key": "statusID", "value": "2", "description": "1=Pending, 2=In Progress, 3=Completed, 4=Cancelled" }
          ]
        },
        "url": "{{baseUrl}}/update.php",
        "description": "POST to update. Response: {\"success\": true}"
      }
    },
    {
      "name": "5. Delete",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "id", "value": "{{documentId}}", "description": "Required - document ID to delete" }
          ]
        },
        "url": "{{baseUrl}}/delete.php",
        "description": "POST to delete. Response: {\"success\": true}"
      }
    },
    {
      "name": "Read All (verification after Create/Update/Delete)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/read_all.php",
        "description": "Use after Create, Update, or Delete to show changes in the PDF."
      }
    }
  ]
}
